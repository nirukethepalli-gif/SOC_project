# ==============================================================================
# Makefile for UVM VIP Verification on Synopsys VCS
# Project: RISC-V VeeR-EL2 Based NN Inference Acceleration SoC
# ==============================================================================

VCS        = vcs
VCS_FLAGS  = -full64 -sverilog -ntb_opts uvm -timescale=1ns/1ps +v2k -notice
VCS_DEBUG  = -debug_access+all -kdb -lca

CORE_CFG   = ../../../core_config
RTL_IP     = ../../../rtl/ip
RTL_BUS    = ../../../rtl/bus
VIP_DIR    = ../vip
ENV_DIR    = ../envs
TEST_DIR   = ../tests
TB_DIR     = ../tb

INCDIRS    = +incdir+$(CORE_CFG) +incdir+$(RTL_IP) +incdir+$(RTL_BUS) \
             +incdir+$(VIP_DIR)/axilite_vip +incdir+$(VIP_DIR)/stream_vip \
             +incdir+$(VIP_DIR)/axi_mem_slave_vip +incdir+$(ENV_DIR) +incdir+$(TEST_DIR)

.PHONY: help test_mm test_act test_dma all_uvm clean

help:
	@echo "======================================================================"
	@echo " Synopsys VCS UVM Verification Makefile for Custom IPs"
	@echo "======================================================================"
	@echo "  make test_mm   : Run UVM Test for Matrix Multiplier VIP & IP"
	@echo "  make test_act  : Run UVM Test for Activation Unit VIP & IP"
	@echo "  make test_dma  : Run UVM Test for DMA Controller VIP & IP"
	@echo "  make all_uvm   : Run full UVM VIP regression across all custom IPs"
	@echo "  make clean     : Clean temporary simulation files"
	@echo "======================================================================"

test_mm:
	@echo "[UVM-VCS] Compiling Matrix Multiplier UVM Testbench..."
	$(VCS) $(VCS_FLAGS) $(VCS_DEBUG) $(INCDIRS) \
		$(VIP_DIR)/axilite_vip/axilite_if.sv \
		$(VIP_DIR)/axilite_vip/axilite_pkg.sv \
		$(VIP_DIR)/stream_vip/stream_if.sv \
		$(VIP_DIR)/stream_vip/stream_pkg.sv \
		$(ENV_DIR)/matrix_mult_env.sv \
		$(TEST_DIR)/matrix_mult_test_pkg.sv \
		$(RTL_IP)/matrix_multiplier.sv \
		$(TB_DIR)/tb_uvm_matrix_mult.sv \
		-o simv_uvm_mm -l compile_uvm_mm.log
	@echo "[UVM-VCS] Running Matrix Multiplier UVM Simulation..."
	./simv_uvm_mm +UVM_TESTNAME=matrix_mult_2x2_test +UVM_VERBOSITY=UVM_LOW -l sim_uvm_mm.log

test_act:
	@echo "[UVM-VCS] Compiling Activation Unit UVM Testbench..."
	$(VCS) $(VCS_FLAGS) $(VCS_DEBUG) $(INCDIRS) \
		$(VIP_DIR)/axilite_vip/axilite_if.sv \
		$(VIP_DIR)/axilite_vip/axilite_pkg.sv \
		$(ENV_DIR)/activation_env.sv \
		$(TEST_DIR)/activation_test_pkg.sv \
		$(RTL_IP)/activation_unit.sv \
		$(TB_DIR)/tb_uvm_activation.sv \
		-o simv_uvm_act -l compile_uvm_act.log
	@echo "[UVM-VCS] Running Activation Unit UVM Simulation..."
	./simv_uvm_act +UVM_TESTNAME=activation_all_func_test +UVM_VERBOSITY=UVM_LOW -l sim_uvm_act.log

test_dma:
	@echo "[UVM-VCS] Compiling DMA Controller UVM Testbench..."
	$(VCS) $(VCS_FLAGS) $(VCS_DEBUG) $(INCDIRS) \
		$(VIP_DIR)/axilite_vip/axilite_if.sv \
		$(VIP_DIR)/axilite_vip/axilite_pkg.sv \
		$(VIP_DIR)/axi_mem_slave_vip/axi_mem_slave_if.sv \
		$(VIP_DIR)/axi_mem_slave_vip/axi_mem_slave_pkg.sv \
		$(ENV_DIR)/dma_env.sv \
		$(TEST_DIR)/dma_test_pkg.sv \
		$(RTL_IP)/dma_controller.sv \
		$(TB_DIR)/tb_uvm_dma.sv \
		-o simv_uvm_dma -l compile_uvm_dma.log
	@echo "[UVM-VCS] Running DMA Controller UVM Simulation..."
	./simv_uvm_dma +UVM_TESTNAME=dma_transfer_test +UVM_VERBOSITY=UVM_LOW -l sim_uvm_dma.log

all_uvm: test_mm test_act test_dma
	@echo "======================================================================"
	@echo "=== [UVM REGRESSION SUMMARY] ALL VIPs & IP ENVs PASSED 100%! ==="
	@echo "======================================================================"

clean:
	rm -rf simv* csrc *.daidir *.log ucli.key vc_hdrs.h DVEfiles *.vpd *.vcd *.fsdb novas.* verdiLog
